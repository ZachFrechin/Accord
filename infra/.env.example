# Test-server config template. Prefer `./gen-deploy-env.sh` (fills all secrets
# consistently); copy this to `.env` only if you want to set values by hand.
# `__` is the nesting separator (SERVER__PORT → server.port).

# ---- infra credentials (used by docker-compose.deploy.yml) ------------------
POSTGRES_USER=accord
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=accord
MINIO_ROOT_USER=accord
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
STORAGE_BUCKET=accord-attachments
STORAGE_AVATARS_BUCKET=accord-avatars

# ---- backend config (env_file) ----------------------------------------------
SERVER__HOST=0.0.0.0
SERVER__PORT=8090
# Refuses to boot if any secret below is still a dev default (see AppConfig::validate).
SERVER__PRODUCTION=true
SERVER__PUBLIC_URL=http://localhost:8090
# Desktop webview origin differs per OS: tauri://localhost (macOS/Linux),
# http(s)://tauri.localhost (Windows/WebView2). List all three for a built app.
SERVER__CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420

# Must match POSTGRES_* above.
DATABASE__URL=postgres://accord:CHANGE_ME_db_password@postgres:5432/accord
REDIS__URL=redis://redis:6379
NATS__URL=nats://nats:4222

STORAGE__ENDPOINT=http://minio:9000
STORAGE__PUBLIC_ENDPOINT=http://localhost:9000
STORAGE__REGION=us-east-1
STORAGE__BUCKET=accord-attachments
STORAGE__AVATARS_BUCKET=accord-avatars
STORAGE__ACCESS_KEY=accord
# Must match MINIO_ROOT_PASSWORD above.
STORAGE__SECRET_KEY=CHANGE_ME_minio_password

LIVEKIT__URL=ws://localhost:7880
LIVEKIT__API_KEY=CHANGE_ME_livekit_key
LIVEKIT__API_SECRET=CHANGE_ME_livekit_secret

# 32+ random chars.
AUTH__TOTP_ENC_KEY=CHANGE_ME_totp_key

# Comma-separated emails promoted to instance admin at boot / registration —
# this is how the FIRST administrator is chosen; more can then be promoted from
# the in-app admin panel (Réglages → Administration).
# AUTH__BOOTSTRAP_ADMIN_EMAILS=you@example.com

# Single-line base64 of an Ed25519 PKCS#8 key:
#   openssl genpkey -algorithm ed25519 -outform DER | base64 | tr -d '\n'
JWT__PRIVATE_KEY_PEM=CHANGE_ME_base64_ed25519_pkcs8

EMAIL__SMTP_URL=smtp://mailpit:1025
EMAIL__FROM=Accord <no-reply@accord.local>

# ── Intégration jeux (rangs de profil) ──────────────────────────────────────
# Clés PROPRES à chaque instance — jamais commitées, jamais exposées par l'API.
# Vide = le jeu apparaît « non configuré » côté client, rien ne casse.
# Riot (LoL) : https://developer.riotgames.com  (clé dev 24 h ou clé produit)
GAMES__RIOT_API_KEY=
# FACEIT (CS2) : https://developers.faceit.com → app → Data API key
GAMES__FACEIT_API_KEY=

# --- Notifications push mobiles (facultatif) ---------------------------------
# Compte de service Firebase de VOTRE projet (console Firebase > Parametres du
# projet > Comptes de service > Generer une nouvelle cle privee). Accepte le
# JSON lui-meme ou un chemin vers le fichier. Vide = pas de push : les
# notifications restent liees a une connexion vive, rien d'autre ne change.
# Ce secret permet d'envoyer des push a tous les appareils de l'instance.
PUSH__FCM_CREDENTIALS=
