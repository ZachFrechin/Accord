# ─────────────────────────────────────────────────────────────────────────────
# Accord2 — environment template.
#
# Copy to `.env` (loaded by dotenvy) and adjust for your local setup.
# Defaults live in `config/default.toml`; env vars OVERRIDE them.
# Nesting separator is a double underscore: SERVER__PORT -> [server].port
#
# NEVER commit real secrets. This file must contain placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
# Bind address. Use 0.0.0.0 in containers; 127.0.0.1 for local-only.
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
# CORS allowlist (comma-separated origins). NEVER use a wildcard/permissive value.
SERVER__CORS_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173
# Public base URL of this backend (used to build links in outgoing emails).
SERVER__PUBLIC_URL=http://localhost:8080

# ── Database (Postgres) ─── REQUIRED (boot fails loud if unset) ──────────────
# Dev credentials from docker-compose (user=accord pass=accord db=accord).
DATABASE__URL=postgres://accord:accord@localhost:5432/accord
DATABASE__MAX_CONNECTIONS=10

# ── Redis ─────────────────── REQUIRED (presence, rate-limit, cache) ─────────
REDIS__URL=redis://localhost:6379

# ── NATS ──────────────────── REQUIRED (cross-node realtime fan-out) ─────────
NATS__URL=nats://localhost:4222

# ── Auth core (all OPTIONAL — sane defaults) ─────────────────────────────────
# Ed25519 signing key (PKCS#8 PEM). If unset, a dev-EPHEMERAL key is generated at
# boot (a loud warning is logged; tokens do NOT survive a restart). For prod,
# generate one:  openssl genpkey -algorithm ed25519
# JWT__PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT__KEY_ID=accord-ed25519-1
# AUTH__ACCESS_TTL_SECS=600          # access-token lifetime (short; revoke via session)
# AUTH__REFRESH_TTL_DAYS=30
# AUTH__SESSION_ABSOLUTE_TTL_DAYS=90
# AUTH__MIN_PASSWORD_LEN=12
# AUTH__HIBP_ENABLED=true            # reject breached passwords at registration
# AUTH__BOOTSTRAP_ADMIN_EMAILS=you@example.com  # comma-separated; these accounts become
#                                    # instance admins at boot or the moment they register

# ── Email (transactional, via SMTP relay) ────────────────────────────────────
# Dev: Mailpit from docker-compose (SMTP 1025, web UI http://localhost:8025).
# Prod: your provider's SMTP endpoint, e.g. smtps://apikey:SECRET@smtp.host:465
EMAIL__SMTP_URL=smtp://localhost:1025
EMAIL__FROM=Accord <no-reply@accord.local>
# EMAIL__OUTBOX_POLL_SECS=5
# EMAIL__MAX_ATTEMPTS=6

# ── Telemetry / observability ───────────────────────────────────────────────
# OTLP gRPC endpoint of the OpenTelemetry collector.
TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
TELEMETRY__SERVICE_NAME=accord-backend
# Log output format: "json" (prod) or "pretty" (local dev).
TELEMETRY__LOG_FORMAT=pretty

# ── Tracing verbosity ───────────────────────────────────────────────────────
# Standard EnvFilter directive consumed by tracing-subscriber.
RUST_LOG=accord_backend=debug,tower_http=info,axum=info,sqlx=warn

# ── LiveKit (voice/video calls, Phase 4) ────────────────────────────────────
# SFU key/secret (dev pair from infra/livekit.yaml). Override the secret in prod.
LIVEKIT__API_KEY=accord_key
LIVEKIT__API_SECRET=accord_dev_secret
LIVEKIT__URL=ws://localhost:7880
