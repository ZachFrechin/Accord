{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accord",
  "version": "0.1.0",
  "identifier": "app.accord.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Accord"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "host": "accordapp.fr",
          "pathPrefix": [
            "/join"
          ]
        }
      ]
    }
  }
}
